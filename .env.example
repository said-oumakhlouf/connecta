# Adresse publique du backend NestJS, sans slash final.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Origine publique du site (https, sans slash final) : canonicals, sitemap, données structurées.
# NEXT_PUBLIC_SITE_URL=https://connecta.fr

# Indexation par les moteurs de recherche. Laisser désactivée tant que Stripe est en mode TEST :
# toutes les pages restent en noindex et robots.txt bloque l'exploration.
# NEXT_PUBLIC_ALLOW_INDEXING=true
